{
  "name": "monstersirenwebpage",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:portable": "vite build --base ./ --outDir dist-portable",
    "preview": "vite preview",
    "worker:dev": "wrangler dev",
    "worker:dry-run": "wrangler deploy --dry-run",
    "worker:deploy": "wrangler deploy",
    "assets:audit": "node scripts/assets/audit-operator-assets.mjs",
    "assets:sync": "node scripts/assets/sync-operator-assets.mjs",
    "activities:sync-assets": "node scripts/assets/sync-activity-assets.mjs",
    "activities:sync-pools": "node scripts/generate-activity-pool-catalog.mjs",
    "activities:push-pools": "node scripts/push-activity-pools-to-supabase.mjs",
    "activities:sync": "npm run activities:sync-pools && npm run activities:push-pools",
    "activities:audit-pools": "node scripts/audit-activity-pools.mjs",
    "character-eps:sync": "node scripts/sync-character-eps.mjs",
    "test:character-eps": "node --test test/character-ep-matching.test.mjs",
    "music:audit-audio": "node scripts/audit-music-audio.mjs"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "opencc-js": "^1.3.1",
    "vue": "^3.4.0",
    "vue-i18n": "^9.14.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "playwright": "^1.62.1",
    "vite": "^5.0.0",
    "wrangler": "^4.111.0"
  }
}
